<!-- views/index.ejs -->
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }
        .hero {
            background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('https://placehold.co/1920x1080/2f5341/fff?text=Locker+Hero+Image');
            background-size: cover;
            background-position: center;
        }
    </style>
</head>
<body class="text-gray-800">
    <!-- Header/Navigation Bar -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white shadow-md">
        <nav class="container mx-auto px-4 py-4 flex justify-between items-center">
            <a href="#" class="text-2xl font-bold text-gray-900">Taridox</a>
            <ul class="hidden md:flex space-x-6">
                <li><a href="#who-we-are" class="text-gray-600 hover:text-blue-600 transition-colors">Who we are</a></li>
                <li><a href="#our-products" class="text-gray-600 hover:text-blue-600 transition-colors">Our products</a></li>
                <li><a href="/locker_selection" class="text-gray-600 hover:text-blue-600 transition-colors">Our deployed lockers</a></li>
                <li><a href="#contact-us" class="text-gray-600 hover:text-blue-600 transition-colors">Contact us</a></li>
            </ul>
            <a href="/login" class="bg-blue-600 text-white px-6 py-2 rounded-full shadow-lg hover:bg-blue-700 transition-colors">E-commerce Login</a>
        </nav>
    </header>

    <!-- Hero Section -->
    <section class="hero h-screen flex items-center justify-center text-center text-white">
        <div>
            <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-4">Smart Locker Solutions for Modern E-commerce</h1>
            <p class="text-xl md:text-2xl font-light max-w-2xl mx-auto mb-8">Efficient, secure, and seamless delivery management for your customers.</p>
            <a href="#our-products" class="bg-white text-blue-600 px-8 py-3 rounded-full font-bold shadow-lg hover:bg-gray-100 transition-colors">Discover Our Solutions</a>
        </div>
    </section>

    <!-- Who We Are Section -->
    <section id="who-we-are" class="container mx-auto px-4 py-20">
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="order-2 md:order-1">
                <img src="https://placehold.co/600x400/e2e8f0/64748b?text=Our+Team" alt="A team working together" class="rounded-lg shadow-xl w-full">
            </div>
            <div class="order-1 md:order-2">
                <h2 class="text-4xl font-bold mb-4">Who We Are</h2>
                <p class="text-lg text-gray-600 mb-4">
                    Taridox is a leader in innovative logistics and delivery solutions. We specialize in developing and deploying smart locker systems that revolutionize the way businesses handle package delivery. Our mission is to provide secure, convenient, and environmentally friendly delivery options for both e-commerce companies and their customers.
                </p>
                <p class="text-lg text-gray-600">
                    With a focus on reliability and technology, our team is dedicated to building robust management software and durable hardware that seamlessly integrates into any city or business environment.
                </p>
            </div>
        </div>
    </section>

    <!-- Our Products Section -->
    <section id="our-products" class="bg-gray-50 px-4 py-20">
        <div class="container mx-auto">
            <h2 class="text-4xl font-bold text-center mb-12">Our Products</h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Product Card 1: Small Locker -->
                <div class="bg-white p-8 rounded-lg shadow-lg text-center">
                    <img src="https://placehold.co/400x300/e2e8f0/64748b?text=Small+Locker" alt="Small Locker" class="mx-auto mb-6 rounded-md">
                    <h3 class="text-2xl font-bold mb-2">Compact Locker Series</h3>
                    <p class="text-gray-600">Perfect for dense urban areas and small packages. Designed for easy installation and high efficiency.</p>
                </div>
                <!-- Product Card 2: Large Locker -->
                <div class="bg-white p-8 rounded-lg shadow-lg text-center">
                    <img src="https://placehold.co/400x300/e2e8f0/64748b?text=Large+Locker" alt="Large Locker" class="mx-auto mb-6 rounded-md">
                    <h3 class="text-2xl font-bold mb-2">Heavy Duty Series</h3>
                    <p class="text-gray-600">Our large-capacity lockers are built to handle oversized packages, providing maximum flexibility for your deliveries.</p>
                </div>
                <!-- Product Card 3: Management System -->
                <div class="bg-white p-8 rounded-lg shadow-lg text-center">
                    <img src="https://placehold.co/400x300/e2e8f0/64748b?text=Management+System" alt="Management System Interface" class="mx-auto mb-6 rounded-md">
                    <h3 class="text-2xl font-bold mb-2">Locker Management System</h3>
                    <p class="text-gray-600">Our comprehensive software provides real-time tracking, remote management, and a seamless user experience.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Us Section -->
    <section id="contact-us" class="container mx-auto px-4 py-20">
        <div class="max-w-lg mx-auto text-center">
            <h2 class="text-4xl font-bold mb-4">Contact Us</h2>
            <p class="text-lg text-gray-600 mb-8">
                Ready to improve your delivery service? Fill out the form below and we'll get in touch with you shortly.
            </p>
            <form action="#" method="POST" class="space-y-6 text-left">
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700">Name</label>
                    <input type="text" id="name" name="name" required class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                </div>
                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
                    <input type="email" id="email" name="email" required class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                </div>
                <div>
                    <label for="phone" class="block text-sm font-medium text-gray-700">Phone Number</label>
                    <input type="tel" id="phone" name="phone" class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                </div>
                <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-lg font-bold text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    Send Message
                </button>
            </form>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white py-12">
        <div class="container mx-auto px-4 text-center">
            <p>&copy; 2024 Taridox Locker Solutions. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>

