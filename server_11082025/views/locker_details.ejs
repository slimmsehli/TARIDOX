<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Locker Details: <%= locker.name %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom styles for the toggle switch */
        .switch {
            position: relative;
            display: inline-block;
            width: 60px;
            height: 34px;
        }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #555; /* Darker gray for inactive switch in dark mode */
            -webkit-transition: .4s;
            transition: .4s;
            border-radius: 34px;
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: #eee; /* Lighter handle in dark mode */
            -webkit-transition: .4s;
            transition: .4s;
            border-radius: 50%;
        }

        /* Adjusted switch color for consistency with new theme */
        input:checked + .slider {
            background-color: #34D399; /* A vibrant emerald green for active */
        }

        input:focus + .slider {
            box-shadow: 0 0 1px #34D399;
        }

        input:checked + .slider:before {
            -webkit-transform: translateX(26px);
            -ms-transform: translateX(26px);
            transform: translateX(26px);
        }

        /* Rounded sliders */
        .slider.round {
            border-radius: 34px;
        }

        .slider.round:before {
            border-radius: 50%;
        }
    </style>
</head>
<body class="bg-gray-900 text-gray-200 p-8">
    <div class="max-w-4xl mx-auto bg-gray-800 p-6 rounded-lg shadow-lg"> <h1 class="text-3xl font-bold mb-6 text-emerald-400">Locker Details: <%= locker.name %></h1> <div class="mb-6 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-gray-900 p-4 rounded-md"> <p class="text-gray-300"><strong>ID:</strong> <%= locker.locker_id %></p>
                <p class="text-gray-300"><strong>Business:</strong> <%= locker.business_name %></p>
                <p class="text-gray-300"><strong>Location:</strong> <%= locker.latitude %>, <%= locker.longitude %></p>
                <p class="text-gray-300"><strong>Hours:</strong> <%= locker.opening_hours %></p>
                <p class="text-gray-300"><strong>Total Boxes:</strong> <%= locker.total_boxes %></p>
            </div>
            <div class="bg-gray-900 p-4 rounded-md "> <p class="text-gray-300"><strong>Full Boxes:</strong> <%= locker.full_boxes %></p>
                <p class="text-gray-300"><strong>Empty Boxes Left:</strong> <%= locker.empty_boxes_left %></p>
                <p class="text-gray-300"><strong>Fullness:</strong> <%= locker.fullness %></p>
                <p class="text-gray-300"><strong>Status:</strong> <span id="lockerStatus" class="font-semibold <%= locker.status === 'online' ? 'text-emerald-400' : (locker.status === 'offline' ? 'text-red-500' : 'text-gray-400') %>"><%= locker.status %></span></p> </div>
        </div>

        <% if (!isClientView) { %>
            <div class="mb-6 flex items-center space-x-4">
                <a href="/edit_locker/<%= locker.locker_id %>" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-4 rounded">
                    Edit Locker Details
                </a>
                <label class="switch">
                    <input type="checkbox" id="lockerToggleSwitch" <%= locker.status === 'online' ? 'checked' : '' %>>
                    <span class="slider round"></span>
                </label>
                <span class="text-gray-300 font-semibold">Locker Online/Offline</span>
            </div>
        <% } %>

        <h2 class="text-2xl font-bold mb-4 text-emerald-400">Boxes</h2> <% if (boxes && boxes.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="min-w-full bg-gray-900 border border-gray-700"> <thead>
                        <tr class="bg-gray-950 text-white"> <th class="py-2 px-4 border-b border-green-800">Box ID</th>
                            <th class="py-2 px-4 border-b border-green-800">Status</th>
                            <th class="py-2 px-4 border-b border-green-800">Parcel Name</th>
                            <th class="py-2 px-4 border-b border-green-800">Customer Name</th>
                            <th class="py-2 px-4 border-b border-green-800">Occupied From</th>
                            <th class="py-2 px-4 border-b border-green-800">Box Health</th>
                            <% if (!isClientView) { %>
                                <th class="py-2 px-4 border-b border-green-800">Actions</th>
                            <% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% boxes.forEach(box => { %>
                            <tr class="hover:bg-gray-700 <%= box.status === 'empty' ? 'text-gray-500' : 'text-gray-300' %>"> <td class="py-2 px-4 border-b border-gray-700 text-center"><%= box.box_id %></td>
                                <td class="py-2 px-4 border-b border-gray-700 text-center">
                                    <span class="font-semibold <%= box.status === 'full' ? 'text-red-500' : (box.status === 'empty' ? 'text-emerald-400' : 'text-orange-400') %>"> <%= box.status %>
                                    </span>
                                </td>
                                <td class="py-2 px-4 border-b border-gray-700 text-center"><%= box.parcel_name || 'N/A' %></td>
                                <td class="py-2 px-4 border-b border-gray-700 text-center"><%= box.customer_name || 'N/A' %></td>
                                <td class="py-2 px-4 border-b border-gray-700 text-center"><%= box.occupied_from || 'N/A' %></td>
                                <td class="py-2 px-4 border-b border-gray-700 text-center"><%= box.box_health || 'N/A' %></td>
                                <% if (!isClientView) { %>
                                    <td class="py-2 px-4 border-b border-gray-700 text-center whitespace-nowrap">
                                        <a href="/locker/<%= locker.locker_id %>/box/edit/<%= box.box_id %>" class="bg-yellow-500 hover:bg-yellow-600 text-white text-sm py-1 px-2 rounded inline-block mr-2">Edit</a>
                                        <form action="/locker/<%= locker.locker_id %>/box/pickup/<%= box.box_id %>" method="POST" class="inline-block" onsubmit="return confirm('Are you sure you want to mark this box as picked up? This will clear its contents.');">
                                            <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white text-sm py-1 px-2 rounded" <%= box.status === 'empty' ? 'disabled' : '' %>>Pick Up</button>
                                        </form>
                                        <a href="/box_history/<%= box.box_id %>" class="bg-gray-600 hover:bg-gray-700 text-white text-sm py-1 px-2 rounded inline-block ml-2">History</a>
                                    </td>
                                <% } else { %>
                                    <td class="py-2 px-4 border-b border-gray-700 text-center whitespace-nowrap">
                                        <button onclick="showFillForm(<%= box.box_id %>)" class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm py-1 px-2 rounded">Fill</button>
                                        <button onclick="confirmPickup(<%= box.box_id %>)" class="bg-red-600 hover:bg-red-700 text-white text-sm py-1 px-2 rounded">Pick Up</button>
                                    </td>
                                <% } %>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="text-gray-400">No boxes found for this locker.</p> <% } %>

        <div class="mt-8">
            <a href="/" class="text-emerald-400 hover:underline">Back to Lockers List</a> </div>
    </div>

    <% if (isClientView) { %>
        <div id="fillParcelModal" class="fixed inset-0 bg-gray-900 bg-opacity-75 overflow-y-auto h-full w-full hidden">
            <div class="relative top-20 mx-auto p-5 border border-gray-700 w-96 shadow-lg rounded-md bg-gray-800 text-gray-200"> <h3 class="text-xl font-bold mb-4 text-emerald-400">Fill Box with Parcel</h3>
                <form id="fillParcelForm">
                    <input type="hidden" id="fillBoxId" name="box_id">
                    <div class="mb-3">
                        <label for="parcelName" class="block text-sm font-medium text-gray-300">Parcel Name:</label>
                        <input type="text" id="parcelName" name="parcel_name" class="mt-1 block w-full border border-gray-600 rounded-md shadow-sm p-2 bg-gray-700 text-gray-200" required>
                    </div>
                    <div class="mb-3">
                        <label for="customerName" class="block text-sm font-medium text-gray-300">Customer Name:</label>
                        <input type="text" id="customerName" name="customer_name" class="mt-1 block w-full border border-gray-600 rounded-md shadow-sm p-2 bg-gray-700 text-gray-200" required>
                    </div>
                    <div class="mb-3">
                        <label for="customerPhone" class="block text-sm font-medium text-gray-300">Customer Phone (Optional):</label>
                        <input type="text" id="customerPhone" name="customer_phone" class="mt-1 block w-full border border-gray-600 rounded-md shadow-sm p-2 bg-gray-700 text-gray-200">
                    </div>
                    <div class="mb-3">
                        <label for="height" class="block text-sm font-medium text-gray-300">Height (cm):</label>
                        <input type="number" id="height" name="height" class="mt-1 block w-full border border-gray-600 rounded-md shadow-sm p-2 bg-gray-700 text-gray-200" value="20" required>
                    </div>
                    <div class="mb-3">
                        <label for="width" class="block text-sm font-medium text-gray-300">Width (cm):</label>
                        <input type="number" id="width" name="width" class="mt-1 block w-full border border-gray-600 rounded-md shadow-sm p-2 bg-gray-700 text-gray-200" value="20" required>
                    </div>
                    <div class="mb-3">
                        <label for="length" class="block text-sm font-medium text-gray-300">Length (cm):</label>
                        <input type="number" id="length" name="length" class="mt-1 block w-full border border-gray-600 rounded-md shadow-sm p-2 bg-gray-700 text-gray-200" value="20" required>
                    </div>
                    <div class="mb-3">
                        <label for="volume" class="block text-sm font-medium text-gray-300">Volume (cm³):</label>
                        <input type="number" id="volume" name="volume" class="mt-1 block w-full border border-gray-600 rounded-md shadow-sm p-2 bg-gray-700 text-gray-200" value="8000" readonly>
                    </div>
                    <div class="mt-4 flex justify-end space-x-2">
                        <button type="button" onclick="closeFillForm()" class="bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded">Cancel</button>
                        <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-4 rounded">Fill Box</button>
                    </div>
                </form>
            </div>
        </div>
    <% } %>

    <script>
        // Only add event listeners if the view is for admin (not client)
        <% if (!isClientView) { %>
            document.addEventListener('DOMContentLoaded', () => {
                const lockerId = <%= locker.locker_id %>;
                const lockerToggleSwitch = document.getElementById('lockerToggleSwitch');
                const lockerStatusSpan = document.getElementById('lockerStatus');

                // Initial state of the switch based on locker.status
                lockerToggleSwitch.checked = (<%= locker.status === 'online' %>);

                lockerToggleSwitch.addEventListener('change', async () => {
                    const isChecked = lockerToggleSwitch.checked; // This is the NEW state of the switch
                    const action = isChecked ? 'connect' : 'disconnect'; // 'connect' if checked, 'disconnect' if unchecked

                    // Confirmation message for the user
                    const confirmMessage = isChecked ?
                        'Are you sure you want to activate this locker? (It will be marked as online)' :
                        'Are you sure you want to deactivate this locker? (It will be marked as offline)';

                    //if (!confirm(confirmMessage)) {
                        // If user cancels, revert the switch state to its previous state
                        lockerToggleSwitch.checked = !isChecked;
                    //    return; // Stop execution
                    //}

                    try {
                        const response = await fetch(`/api/locker/${lockerId}/${action}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                        });

                        const data = await response.json();

                        if (response.ok) {
                            console.log(data.message);
                            alert(data.message); // Provide success feedback

                            // === Update the UI based on the actual successful action ===
                            if (action === 'connect') {
                                lockerStatusSpan.textContent = 'online';
                                lockerStatusSpan.classList.remove('text-red-500', 'text-gray-400');
                                lockerStatusSpan.classList.add('text-emerald-400');
                                lockerToggleSwitch.checked = true; // Ensure the switch is checked
                            } else { // action === 'disconnect'
                                lockerStatusSpan.textContent = 'offline';
                                lockerStatusSpan.classList.remove('text-emerald-400', 'text-gray-400');
                                lockerStatusSpan.classList.add('text-red-500');
                                lockerToggleSwitch.checked = false; // Ensure the switch is unchecked
                            }

                        } else {
                            console.error('API Error:', data.message);
                            alert('Error: ' + data.message);
                            lockerToggleSwitch.checked = !isChecked; // Revert switch on API error
                        }
                    } catch (error) {
                        console.error('Network error:', error);
                        alert('Network error. Could not connect to server or request failed.');
                        lockerToggleSwitch.checked = !isChecked; // Revert switch on network error
                    }
                });
            });
        <% } else { %>
            // Client-side JavaScript for Fill/Pickup actions
            const fillParcelModal = document.getElementById('fillParcelModal');
            const fillParcelForm = document.getElementById('fillParcelForm');
            const fillBoxIdInput = document.getElementById('fillBoxId');
            const heightInput = document.getElementById('height');
            const widthInput = document.getElementById('width');
            const lengthInput = document.getElementById('length');
            const volumeInput = document.getElementById('volume');

            function calculateVolume() {
                const h = parseFloat(heightInput.value) || 0;
                const w = parseFloat(widthInput.value) || 0;
                const l = parseFloat(lengthInput.value) || 0;
                volumeInput.value = (h * w * l).toFixed(0);
            }

            heightInput.addEventListener('input', calculateVolume);
            widthInput.addEventListener('input', calculateVolume);
            lengthInput.addEventListener('input', calculateVolume);

            function showFillForm(boxId) {
                fillBoxIdInput.value = boxId;
                fillParcelModal.classList.remove('hidden');
                calculateVolume(); // Calculate initial volume
            }

            function closeFillForm() {
                fillParcelModal.classList.add('hidden');
                fillParcelForm.reset(); // Reset form fields
            }

            fillParcelForm.addEventListener('submit', async (event) => {
                event.preventDefault();
                const lockerId = <%= locker.locker_id %>;
                const boxId = fillBoxIdInput.value;
                const formData = new FormData(fillParcelForm);
                const data = Object.fromEntries(formData.entries());

                // Ensure numeric values are numbers
                data.height = parseFloat(data.height);
                data.width = parseFloat(data.width);
                data.length = parseFloat(data.length);
                data.volume = parseFloat(data.volume);

                try {
                    const response = await fetch(`/api/locker/${lockerId}/box/${boxId}/fill_parcel`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(data),
                    });

                    const result = await response.json();

                    if (response.ok) {
                        alert(result.message);
                        closeFillForm();
                        location.reload(); // Reload the page to show updated box status
                    } else {
                        alert('Error filling box: ' + result.message);
                    }
                } catch (error) {
                        console.error('Fetch error:', error);
                        alert('Network error during fill operation.');
                }
            });

            async function confirmPickup(boxId) {
                if (confirm('Are you sure you want to pick up the parcel from this box?')) {
                    const lockerId = <%= locker.locker_id %>;
                    try {
                        const response = await fetch(`/api/locker/${lockerId}/box/${boxId}/pickup_parcel`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                        });

                        const result = await response.json();

                        if (response.ok) {
                            alert(result.message);
                            location.reload(); // Reload the page to show updated box status
                        } else {
                            alert('Error picking up parcel: ' + result.message);
                        }
                    } catch (error) {
                        console.error('Fetch error:', error);
                        alert('Network error during pickup operation.');
                    }
                }
            }
        <% } %>
    </script>
</body>
</html>
